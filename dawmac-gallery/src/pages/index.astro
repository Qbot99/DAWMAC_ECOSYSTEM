---

<Layout>
  <div class="flex_wrapper">
    <Gallery_list client:only="react" />
    <!-- <Carousel client:load /> -->
  </div>
</Layout>

<style>
  body {
    font-family: "Poppins", Helvetica, Arial, Lucida, sans-serif;
  }
  .flex_wrapper {
    display: flex;
    align-items: start;
    justify-content: center;
  }
</style>
