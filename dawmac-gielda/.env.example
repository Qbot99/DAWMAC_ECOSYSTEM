# Konfiguracja giełdy. Skopiuj jako .env piętro NAD public_html (poza zasięgiem WWW).

# Baza — ten sam serwer i użytkownik co galeria
DB_SERVER=localhost
DB_USER=
DB_PASSWORD=
# Baza z tabelami g_* (może być osobna albo ta sama co galeria)
GIELDA_DB_NAME=
# Baza ze słownikiem aut (car_brand, car_model) — zwykle baza galerii.
# Puste = szukaj w GIELDA_DB_NAME.
CARS_DB_NAME=

# Adres giełdy (do linków w e-mailach), bez ukośnika na końcu
APP_URL=https://dawmac.pl/gielda

# Zdjęcia: katalog na dysku i adres, pod którym są widoczne
UPLOAD_DIR=/home/dawmac/domains/dawmac.pl/public_html/gielda/uploads
UPLOAD_URL=/gielda/uploads

# E-maile: mail (funkcja mail() hostingu) albo log (storage/mail.log, do testów)
MAIL_MODE=mail
MAIL_FROM=gielda@dawmac.pl

# Dane prawne (DSA art. 11-12) — pokazywane w regulaminie i stopce
CONTACT_EMAIL=gielda@dawmac.pl
AUTHORITY_EMAIL=gielda@dawmac.pl
OPERATOR_INFO=DAWMAC [pełna nazwa firmy, adres, NIP]
# Podbij przy każdej zmianie regulaminu — użytkownicy dostaną prośbę o akceptację
TERMS_VERSION=2026-10-01

# Ile dni ogłoszenie jest widoczne
LISTING_DAYS=60

# 1 na produkcji (HTTPS). 0 tylko lokalnie bez HTTPS.
COOKIE_SECURE=1
# Tylko do pracy lokalnej z Vite, np. http://localhost:5173
CORS_ORIGINS=
